# AI semantic search (PRD §3.3). Without a key the app falls back to keyword matching.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# SMS OTP delivery via Twilio. If unset, the app runs in DEV mode and shows the code on screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SQLite file location (default: ./data/community.db)
# DATABASE_PATH=
